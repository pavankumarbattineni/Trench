TRENCH_CONFIG='{
  "ENVIRONMENT": "DEV",
  "FRONTEND_BASE_URL": "http://localhost:3000",
  "DB": {
    "username": "postgres",
    "password": "password",
    "database": "trench",
    "ip_address": "localhost",
    "port": "5432",
    "pool_size": 40,
    "max_overflow": 10,
    "pool_timeout": 30,
    "pool_recycle": 1800
  },
  "JWT": {
    "secret_key": "replace-with-a-long-random-secret",
    "algorithm": "HS256",
    "access_token_expire_minutes": 15,
    "refresh_token_expire_days": 30
  },
  "ENCRYPTION": {
    "encryption_key": "replace-with-a-base64-fernet-key"
  },
  "FIREBASE": {
    "credentials_json_base64": "replace-with-base64-of-your-service-account-key-json",
    "web_api_key": "replace-with-your-firebase-web-api-key"
  },
  "GROQ": {
    "api_key": "replace-with-a-groq-api-key"
  },
  "STORAGE": {
    "local_root_path": "/absolute/path/to/trench_backend/storage"
  },
  "BACKBLAZE": {
    "endpoint_url": "https://s3.replace-with-your-b2-region.backblazeb2.com",
    "region": "replace-with-your-b2-region",
    "bucket_name": "Trench",
    "application_key_id": "replace-with-your-b2-key-id",
    "application_key": "replace-with-your-b2-application-key"
  },
  "PINECONE": {
    "api_key": "replace-with-a-pinecone-api-key",
    "index_name": "trench-platform"
  },
  "LLAMAPARSE": {
    "api_key": "replace-with-a-llamaparse-api-key"
  },
  "COHERE_RERANKER": {
    "api_key": "replace-with-a-cohere-api-key"
  },
  "GEMINI": {
    "api_key": "replace-with-a-gemini-api-key"
  }
}'

# FIREBASE.credentials_json_base64 above: download the service-account
# key (Firebase Console > Project settings > Service accounts > Generate
# new private key), then base64-encode the whole file with no line
# wrapping, e.g.:
#   base64 -w0 path/to/firebase-adminsdk.json
# and paste the result as that field's value.

# LangSmith tracing (optional) -- leave LANGCHAIN_TRACING unset/false to
# disable. Plain env vars, not part of TRENCH_CONFIG -- see
# app/utils/tracing.py and langgraph.json's "env" key.
LANGSMITH_API_KEY=replace-with-a-langsmith-api-key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING=true
LANGCHAIN_PROJECT=Trench
