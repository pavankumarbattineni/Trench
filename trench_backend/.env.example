TRENCH_CONFIG='{
  "ENVIRONMENT": "DEV",
  "DB": {
    "username": "postgres",
    "password": "password",
    "database": "trench",
    "ip_address": "localhost",
    "port": "5432",
    "pool_size": 40,
    "max_overflow": 10,
    "pool_timeout": 30,
    "pool_recycle": 1800
  },
  "JWT": {
    "secret_key": "replace-with-a-long-random-secret",
    "algorithm": "HS256",
    "access_token_expire_minutes": 15,
    "refresh_token_expire_days": 30
  },
  "MCP": {
    "encryption_key": "replace-with-a-base64-fernet-key"
  },
  "FIREBASE": {
    "credentials_path": "/absolute/path/to/firebase-adminsdk.json"
  },
  "GROQ": {
    "api_key": "replace-with-a-groq-api-key"
  }
}'
